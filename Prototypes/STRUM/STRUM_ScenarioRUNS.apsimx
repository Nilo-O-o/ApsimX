                      "TotalSolarRadiation": 0.0,
                      "Name": "KiwiFruit",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": false,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": false,
                  "ReadOnly": false
                },
