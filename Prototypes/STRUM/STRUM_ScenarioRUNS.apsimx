                },
                {
                  "$type": "Models.Climate.Weather, Models",
                  "ConstantsFile": null,
                  "FileName": "WeatherFiles\\TaurangaAeroEws.met",
                  "ExcelWorkSheetName": "",
                  "Latitude": -37.675,
                  "Tav": 14.963731485711639,
