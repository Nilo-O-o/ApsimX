                    },
                    {
                      "$type": "Models.Management.BiomassRemovalEvents, Models",
                      "PlantToRemoveBiomassFrom": "STRUM",
                      "RemovalType": 2,
                      "StageToSet": null,
                      "RemovalDatesInput": null,
