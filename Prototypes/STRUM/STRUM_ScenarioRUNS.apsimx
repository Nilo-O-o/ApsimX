        {
          "$type": "Models.Core.Simulation, Models",
          "Descriptors": null,
          "Name": "Decidious",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Clock, Models",
              "Start": "2000-07-21T00:00:00",
              "End": "2011-07-01T00:00:00",
              "Name": "Clock",
