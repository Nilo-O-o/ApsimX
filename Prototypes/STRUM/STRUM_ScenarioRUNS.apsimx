                {
                  "$type": "Models.Climate.Weather, Models",
                  "ConstantsFile": null,
                  "FileName": "WeatherFiles\\TaurangaAeroEws.met",
                  "ExcelWorkSheetName": "",
                  "Latitude": -37.675,
                  "Tav": 14.963731485711639,
                  "Amp": 9.594269735332025,
                  "Name": "Weather",
                  "ResourceName": null,
