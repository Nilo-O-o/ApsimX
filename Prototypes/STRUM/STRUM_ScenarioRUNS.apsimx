        {
          "$type": "Models.Manager, Models",
          "CodeArray": [
            "using Models.Climate;",
            "using System;",
            "using Models.Core;",
            "using Models.PMF;",
            "using System.Collections.Generic;",
            "using Models.Soils;",
            "using APSIM.Shared.Utilities;",
            "using Models.Zones;",
            "using Models.PMF.Organs;",
            "using System.Diagnostics;",
            "",
            "namespace Models",
            "{",
            "    [Serializable]",
            "    public class Script : Model",
            "    {",
            "        [Link] private Weather weather;",
            "        [Link(Type = LinkType.Scoped, ByName = true)] private OutputLayers outputLayers;",
            "        private RectangularZone AlleyZone {get; set; }",
            "        private RectangularZone RowZone {get; set;}",
            "        private RectangularZone ThisZone {get; set;}",
            "        private double AreaWidth {get; set;}",
            "        private double TreeWidth {get; set;}",
            "        public double TotRadn {get; set;}",
            "        public double RadInt {get; set;}",
            "        public double FRadInt {get; set;}",
            "        public double ET {get; set;}",
            "        public double ES {get; set;}",
            "        public double PET {get; set;}",
            "        public double InterceptedRadiation {get; set;}",
            "        public double TreeRadInt {get; set;}",
            "        public double TWU {get;set;}",
            "        public double PSW {get;set;}",
            "        public double TotalIrrig_mm {get;set;}",
            "        public double TotalN_kgPerha {get;set;}",
            "        public double RowIrrig {get;set;}",
            "        public double AlleyIrrig {get;set;}",
            "        public double RowN {get;set;}",
            "        public double AlleyN {get;set;}",
            "        public double AlleyWidth {get;set;}",
            "        public double RowWidth {get;set;}",
            "        public double DemandRatio {get;set;}",
            "        public double TranspirationPerTree {get;set;}",
            "               ",
            "        ",
            "        [EventSubscribe(\"StartOfFirstDay\")]",
            "        private void DoStartOfSimulation(object sender, EventArgs e)",
            "        {",
            "               ",
            "               ThisZone = this.Parent.Parent as RectangularZone;",
            "               RowZone = this.Parent.Parent.Parent.FindInScope(\"Row\") as RectangularZone;",
            "               AlleyZone = this.Parent.Parent.Parent.FindInScope(\"Alley\") as RectangularZone;",
            "               if (AlleyZone != null)",
            "                       AlleyWidth = AlleyZone.Width;",
            "               else",
            "               \t\t   AlleyWidth=0;",
            "               if (RowZone != null)",
            "               \t\tRowWidth = RowZone.Width;",
            "               else",
            "               \t\tRowWidth = 0;",
            "               AreaWidth = AlleyWidth + RowWidth;",
            "               TreeWidth = 0;",
            "        }",
            "        ",
            "        [EventSubscribe(\"DoReportCalculations\")]",
            "        private void OnDoReportCalculations(object sender, EventArgs e)",
            "        {",
            "            //Debugger.Break();",
            "            if (ThisZone.Name == \"Row\")",
            "                {",
            "\t\t            TreeRadInt = (double)RowZone.Get(\"STRUM.Leaf.RadiationIntercepted\") + (double)RowZone.Get(\"STRUM.Trunk.EnergyBalance.RadiationInterceptedByDead\");",
            "\t\t            FRadInt = (TreeRadInt * RowWidth)/(weather.Radn * AreaWidth);",
            "\t\t            InterceptedRadiation = RowWidth * (double)RowZone.Get(\"STRUM.Leaf.RadiationIntercepted\");",
            "\t\t            ET = (double)RowZone.Get(\"STRUM.Leaf.Transpiration\") * RowZone.Width/AreaWidth;",
            "\t\t            TreeWidth = (double)RowZone.Get(\"STRUM.Leaf.Width\")/1000;",
            "\t\t            TWU = (double)RowZone.Get(\"STRUM.Leaf.Transpiration\")/(double)RowZone.Get(\"STRUM.Leaf.LAI\") * 2.5; ",
            "\t\t            DemandRatio = MathUtilities.Divide((double)RowZone.Get(\"STRUM.Arbitrator.DM.TotalPlantSupply\"),(double)RowZone.Get(\"STRUM.Arbitrator.DM.TotalPlantDemand\"),0);",
            "\t\t            TranspirationPerTree = (double)RowZone.Get(\"STRUM.Leaf.Transpiration\") * TreeWidth * TreeWidth;",
            "                }",
            "            else if (ThisZone.Name == \"Alley\")",
            "                {",
            "\t\t            FRadInt = ((double)AlleyZone.Get(\"SPRUM.Leaf.RadiationIntercepted\") * AlleyZone.Width)/(weather.Radn * AreaWidth);",
            "\t\t            InterceptedRadiation = AlleyWidth * (double)AlleyZone.Get(\"SPRUM.Leaf.RadiationIntercepted\");",
            "\t\t            ET = (double)AlleyZone.Get(\"SPRUM.Leaf.Transpiration\") * ThisZone.Width/AreaWidth;",
            "                }",
            "            TotRadn = weather.Radn * AreaWidth; ",
            "            ES = (double)ThisZone.Get(\"Soil.SoilWater.Es\") * ThisZone.Width/AreaWidth;",
            "            double PETWidth = Math.Min(Math.Max(TreeWidth,ThisZone.Width),AreaWidth);",
            "            PET = (double)ThisZone.Get(\"Soil.SoilWater.Eo\") * PETWidth/AreaWidth;",
            "            PSW = 0;",
            "            for (int layer = 0; layer < outputLayers.Thickness.Length; layer++)",
            "            {",
            "                PSW += outputLayers.SWmm[layer];",
            "            }",
            "            ",
            "",
            "            if (RowZone != null)",
            "            {",
            "            \t\tRowIrrig = (double)RowZone.Get(\"Irrigation.IrrigationApplied\");",
            "\t\t            RowN = (double)RowZone.Get(\"Fertiliser.NitrogenApplied\");",
            "\t\t    }",
            "\t\t    else",
            "\t\t    {",
            "\t\t    \tRowIrrig = 0;",
            "\t\t    \tRowN = 0;",
            "\t\t    }",
            "\t\t    if (AlleyZone != null)",
            "\t\t    {",
            "\t\t        AlleyIrrig = (double)AlleyZone.Get(\"Irrigation.IrrigationApplied\");",
            "\t\t        AlleyN = (double)AlleyZone.Get(\"Fertiliser.NitrogenApplied\");",
            "\t\t    }",
            "\t\t    else",
            "\t\t    {",
            "\t\t        AlleyIrrig = 0;",
            "                AlleyN = 0;",
            "\t\t    }",
            "            TotalIrrig_mm = (RowIrrig*RowWidth + AlleyIrrig*AlleyWidth)/AreaWidth;",
            "            TotalN_kgPerha = (RowN*RowWidth + AlleyN*AlleyWidth)/AreaWidth;         ",
            "        }",
            "    }",
            "}"
          ],
          "Parameters": [],
          "Name": "AgrgateZoneVariables",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
