          "Children": [
            {
              "$type": "Models.Core.Simulation, Models",
              "Descriptors": null,
              "Name": "Orchard_BAY",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Clock, Models",
                  "Start": "2012-06-21T00:00:00",
                  "End": "2022-12-01T00:00:00",
