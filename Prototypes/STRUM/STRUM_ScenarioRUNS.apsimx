            {
              "$type": "Models.Core.Simulation, Models",
              "Descriptors": null,
              "Name": "BlockJ",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Clock, Models",
                  "Start": "2010-06-24T00:00:00",
                  "End": "2011-06-23T00:00:00",
                  "Name": "Clock",
                  "ResourceName": null,
                  "Children": [],
