                {
                  "$type": "Models.Clock, Models",
                  "Start": "2012-06-21T00:00:00",
                  "End": "2020-07-01T00:00:00",
                  "Name": "Clock",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": false,
