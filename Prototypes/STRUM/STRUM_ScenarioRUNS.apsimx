                    "using Models.Core;",
                    "using System;",
                    "using Models.Management;",
                    "using Models.Climate;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link(Type = LinkType.Scoped, ByName = true)] private Plant strum;",
                    "        [Link(Type = LinkType.Scoped)] private Weather weather;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)] private BiomassRemovalEvents pick;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)] private BiomassRemovalEvents prune;",
                    "        ",
                    "        private void OnStartOfSimulation(object sender, EventArgs e)",
                    "        {",
                    "        }",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            if (weather.DaysSinceWinterSolstice == 200)",
                    "            {",
                    "            \tprune.Remove();",
                    "            }",
                    "            if (weather.DaysSinceWinterSolstice == 250)",
                    "            {",
                    "            \tprune.Remove();",
                    "            }",
                    "            if (weather.DaysSinceWinterSolstice == 300)",
                    "            {",
                    "            \tpick.Remove();",
                    "            }",
                    "        }",
                    "    }",
                    "}"
                  ],
