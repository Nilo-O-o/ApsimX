                    {
                      "$type": "Models.Soils.Soil, Models",
                      "RecordNumber": 0,
                      "ASCOrder": null,
                      "ASCSubOrder": null,
                      "SoilType": null,
                      "LocalName": null,
                      "Site": null,
                      "NearestTown": null,
