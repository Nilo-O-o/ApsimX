                    },
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "StorageRoot",
                      "TypeString": "None",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 0.0,
                      "DeadToResidue": 0.0
                    },
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "FineRoot",
                      "TypeString": "None",
