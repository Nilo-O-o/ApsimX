                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Management;",
                    "using System;",
                    "using Models.Core;",
                    "using APSIM.Core;",
                    "using Models;",
                    "using Models.PMF;",
                    "using Models.Utilities;",
                    "using APSIM.Shared.Utilities;",
                    "using Models.PMF.Phen;",
                    "using System.Diagnostics;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] Plant KiwiFruit;",
                    "        [Link] Clock clock;",
                    "        [Link(Type = LinkType.Path, Path = \"[KiwiFruit].Leaf.Canopy\")]",
                    "        private EnergyBalance canopy;",
                    "        [Link(Type = LinkType.Path, Path = \"[KiwiFruit].Phenology\")]",
                    "        private Phenology phenology;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)]",
                    "        private BiomassRemovalEvents SummerPrune;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)]",
                    "        private BiomassRemovalEvents Pick;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)]",
                    "        private BiomassRemovalEvents AutumnPrune;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)]",
                    "        private BiomassRemovalEvents Defoliate;",
                    "        ",
                    "        [Separator(\"If left blank summer pruning does not happen\")]",
                    "        [Description(\"LAI threshold to trigger summer pruning\")]",
                    "        public double LAIthreshold { get; set; }",
                    "        ",
                    "        [Separator(\"If left blank picking occurs when the fruit reaches matruity\")]",
                    "        [Description(\"Picking date, dd-mmm\")]",
                    "        public string PickingDate { get; set; }",
                    "        ",
                    "        [Separator(\"If left blank autumn pruning occurs on the same day as picking\")]",
                    "        [Description(\"Autmun pruning date, dd-mmm\")]",
                    "        public string AutumnPruneDate { get; set; }",
                    "        ",
                    "        [Separator(\"If left blank winter pruning occurs at the end of the late leaf phase\")]",
                    "        [Description(\"Winter defoliation date, dd-mmm\")]",
                    "        public string WinterDefoliateDate { get; set; }",
                    "        ",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs data)",
                    "        {",
                    "        //Debugger.Break();",
                    "         // prune out leaf and stem every time the canopy gets to big",
                    "         if (double.IsNaN(LAIthreshold))",
                    "         {}",
                    "         else",
                    "         {",
                    "             if (canopy.LAI > LAIthreshold)",
                    "                 {",
                    "                     SummerPrune.Remove();",
                    "                 }",
                    "         }",
                    "         //Remove fruit on picking date if specified otherwise remove fruit when maturity is reached",
                    "         if (String.IsNullOrEmpty(PickingDate))",
                    "            {",
                    "             if (phenology.CurrentStageName == \"FruitMature\")",
                    "                    {",
                    "                        Pick.Remove();",
                    "                    } ",
                    "            }",
                    "         else",
                    "             {",
                    "                if (DateUtilities.DatesEqual(PickingDate,clock.Today)) ",
                    "                    {",
                    "                        Pick.Remove();",
                    "                    } ",
                    "             }",
                    "             ",
                    "         //Remove half of leaf and shoot biomass to approximate autumn pruning on date if specified otherwise do at fruit maturity    ",
                    "         if (String.IsNullOrEmpty(AutumnPruneDate))",
                    "            {",
                    "                if (phenology.CurrentStageName == \"FruitMature\")",
                    "                    {",
                    "                        AutumnPrune.Remove();",
                    "                    } ",
                    "            }",
                    "         else",
                    "            {",
                    "                if (DateUtilities.DatesEqual(AutumnPruneDate,clock.Today)) ",
                    "                    {",
                    "                        AutumnPrune.Remove();",
                    "                    }  ",
                    "            }",
                    "         ",
                    "         //Remove all leaf to approximate defoliation by spaying Copper Sulphate. ",
                    "         //Note, all stem is removed at this time too but it should be moved into a Cane organ as the remaining shoots is kept to provide buds for next year",
                    "         if (String.IsNullOrEmpty(WinterDefoliateDate))",
                    "            {",
                    "                 if (phenology.CurrentStageName == \"StartEndo\")",
                    "                    {",
                    "                        Defoliate.Remove();",
                    "                    }  ",
                    "            }",
                    "         else",
                    "            {",
                    "                if (DateUtilities.DatesEqual(WinterDefoliateDate,clock.Today)) ",
                    "                    {",
                    "                        Defoliate.Remove();",
                    "                    }  ",
                    "            }",
                    "   ",
                    "       }",
                    "    }",
                    "}",
                    "    ",
                    ""
                  ],
                  "Parameters": [
                    {
                      "Key": "LAIthreshold",
                      "Value": "3.9"
                    },
                    {
                      "Key": "PickingDate",
                      "Value": ""
                    },
                    {
                      "Key": "AutumnPruneDate",
                      "Value": ""
                    },
                    {
                      "Key": "WinterDefoliateDate",
                      "Value": ""
                    }
                  ],
                  "Name": "Pruning",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
