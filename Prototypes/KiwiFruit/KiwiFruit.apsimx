                    "               Structure.Set(\"[KiwiFruit].Phenology.BrokenBuds.Vegetative.MultiplyFunction.AllBuds.FixedValue\", (object)BudNumber);",
                    " ",
                    "            }",
                    "            ",
                    "        }",
                    "    }",
