                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Core;",
                    "using System;",
                    "using Models.PMF.Phen;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        //> Links to other Apsim models",
                    "        [Link(ByName = true)] Report stages; ",
                    "        ",
                    "        public string StageName {get; set;}",
                    "        ",
                    "        private void setAndOutput(PhaseChangedType change)",
                    "        {",
                    "           StageName = change.StageName;",
                    "    \t   stages.DoOutput();",
                    "        }",
                    "        ",
                    "        [EventSubscribe(\"PhaseChanged\")]",
                    "        private void OnPhaseChanged(object sender, PhaseChangedType change)",
                    "        {",
                    "        \tif (change.StageName == \"StartFlowering\") {setAndOutput(change);}",
                    "",
                    "        }",
                    "",
                    "\t}",
                    "}"
                  ],
                  "Parameters": [],
                  "Name": "ReportOnEvents",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils.Nutrients;",
                    "using APSIM.Shared.Utilities;",
                    "using Models.Surface;",
                    "using Models.Utilities;",
                    "using Models.Soils.Nutrients;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using Models.Core;",
                    "using System;",
                    "using System.Linq;",
                    "using Models.Interfaces;",
                    "using Models.PMF.Phen;",
                    "using System.Diagnostics;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] private Clock Clock;",
                    "        [Link] private Plant Wheat;",
                    "        [Link] private ISoilWater SoilWater;",
                    "        [Link] private Nutrient nutrient;",
                    "        [Link] private SurfaceOrganicMatter SOM;",
                    "        [Link] private Summary Summary;",
                    "",
                    "        [Description(\"Reset Water? (Yes or No)\")]",
                    "        public bool ResetWater {get;set;}",
                    "",
                    "        [Description(\"Reset Soil Nutrients ? (Yes or No)\")]",
                    "        public bool ResetNutrients {get;set;}",
                    "",
                    "        [Description(\"Reset Surface Organic Matter? (Yes or No)\")]",
                    "        public bool ResetSOM {get;set;}",
                    "",
                    "        [EventSubscribe(\"PhaseChanged\")]",
                    "        private void OnDoManagement(object sender, PhaseChangedType pct)",
                    "        {",
                    "            if (pct.StageName == \"StartGrowth\")",
                    "            {",
                    "                if (ResetWater == true)",
                    "                {",
                    "                    Summary.WriteMessage(this, \"Reset Water\", MessageType.Diagnostic);",
                    "                    SoilWater.Reset();",
                    "                }",
                    "                if (ResetNutrients == true)",
                    "                {",
                    "                    Summary.WriteMessage(this, \"Reset Nitrogen\", MessageType.Diagnostic);",
                    "                    nutrient.Reset();",
                    "                }",
                    "                if (ResetSOM == true)",
                    "                {",
                    "                    Summary.WriteMessage(this, \"Reset Surface OM\", MessageType.Diagnostic);",
                    "                    SOM.Reset();",
                    "                }",
                    "            }",
                    "        }",
                    "    }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "ResetWater",
                      "Value": "True"
                    },
                    {
                      "Key": "ResetNutrients",
                      "Value": "True"
                    },
                    {
                      "Key": "ResetSOM",
                      "Value": "True"
                    }
                  ],
                  "Name": "Reset on date",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
