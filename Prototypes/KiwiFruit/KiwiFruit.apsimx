                              "ResourceName": null,
                              "Children": [
                                {
                                  "$type": "Models.Memo, Models",
                                  "Text": "Modelling Fruit Development in ‘Hayward’ Kiwifruit\n\nAbstract: Dry weight accumulation of kiwifruit during the growing season approximates a simple expolinear curve",
                                  "Name": "Memo",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Functions.ExpressionFunction, Models",
                                  "Units": null,
                                  "Expression": "[Fruit].PotentialSingleBerryDWParams.Ymax* (1 + ([Fruit].PotentialSingleBerryDWParams.te - [Fruit].FruitingPhaseAccTT) / ([Fruit].PotentialSingleBerryDWParams.te - [Fruit].PotentialSingleBerryDWParams.tm)) * ([Fruit].FruitingPhaseAccTT / [Fruit].PotentialSingleBerryDWParams.te) ^ ([Fruit].PotentialSingleBerryDWParams.te / ([Fruit].PotentialSingleBerryDWParams.te - [Fruit].PotentialSingleBerryDWParams.tm))",
