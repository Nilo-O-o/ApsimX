                {
                  "$type": "Models.Management.BiomassRemovalEvents, Models",
                  "NameOfPlantToRemoveFrom": "KiwiFruit",
                  "RemovalType": 5,
                  "StageToSet": null,
                  "RemovalDates": null,
                  "BiomassRemovalFractions": [
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "Leaf",
                      "TypeString": "None",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 0.5,
                      "DeadToResidue": 0.5
                    },
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "Stem",
                      "TypeString": "None",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 0.5,
