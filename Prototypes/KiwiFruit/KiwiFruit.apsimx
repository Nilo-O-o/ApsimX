                    "                FirstDay = true;",
                    "",
                    "                object ResetValue = MaxBudNum;",
                    "                Structure.Set(\"[KiwiFruit].Phenology.BrokenBuds.Vegetative.BrokenBuds.Max_buds.FixedValue\", ResetValue, relativeTo: zone); ",
                    "            }          ",
