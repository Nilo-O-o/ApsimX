                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using APSIM.Core;",
                    "using Models.Soils.Nutrients;",
                    "using System;",
                    "using Models.Core;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using APSIM.Shared.Utilities;",
                    "using System.Linq;",
                    "using Models.Interfaces;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model, IStructureDependency",
                    "    {",
                    "        [Link] private Clock clock;",
                    "        [Link] private Fertiliser fertiliser;",
                    "        [Link] private ISummary summary;",
                    "        [Link] private Soil soil;",
                    "        private Nutrient nutrient;",
                    "        [Link]",
                    "        private IPhysical soilPhysical;",
                    "        public IStructure Structure { private get; set; }",
                    "        ",
                    "        ",
                    "",
                    "",
                    "        [Separator(\"Fertiliser will be applied on the date(s) below\")]",
                    "        [Description(\"Apply fertiliser on the same day(s) each year? If no, then must include the year of appliaction below\")]",
                    "        public bool EachYear { get; set; }",
                    "",
                    "        [Description(\"Dates for one or more fertiliser applications (dd-mmm or dd-mmm-yyyy) as a list with a comma between dates\")]",
                    "        public string[] Dates { get; set; }",
                    "",
                    "        [Separator(\"Test for the mineral N in the soil and don't apply the fertiliser if greater than X kgN/ha is stored in the soil above a depth of Y mm\")]",
                    "        [Description(\"Use a critical soil mineral N to prevent application above a threshold?\")]",
                    "        public bool UseCritNThreshold { get; set; }",
                    "",
                    "        [Description(\"Don't add fertiliser if N in the soil to the depth below exceeds (kg/ha)\")]",
                    "        public double CritNThreshold { get; set; }",
                    "",
                    "        [Description(\"Depth to which the amount of N in the soil should be calculated (mm)\")]",
                    "        public double CritNDepth { get; set; }",
                    "",
                    "        [Separator(\"Fertiliser application details\")]",
                    "        [Description(\"Depth at which to apply the fertiliser (mm)\")]",
                    "        public double Depth { get; set; }",
                    "",
                    "        [Description(\"Amount of fertiliser to apply (kg N /ha) per application\")]",
                    "        public double Amount { get; set; }",
                    "",
                    "        [Description(\"Fertiliser type - select from the list\")]",
                    "        [Display(Type = DisplayType.FertiliserType)]public string FertiliserType { get; set; }",
                    "",
                    "",
                    "        [EventSubscribe(\"StartOfSimulation\")]",
                    "        private void FindSoilNOrNutrient(object sender, EventArgs e)",
                    "        {",
                    "            nutrient =  Structure.Find<Nutrient>() as Nutrient;",
                    "",
                    "            if (nutrient == null)",
                    "                throw new Exception(string.Format(\"Error in script {0}: Unable to find nutrient.\", Name));",
                    "        }",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            if (OnApplicationDate())",
                    "            {",
                    "                if (NContentBelowThreshold())",
                    "                    fertiliser.Apply(Amount, FertiliserType, Depth);",
                    "                else",
                    "                    summary.WriteMessage(this, \"Skipping fertiliser application due to soil mineral N content being above critical threshold.\", MessageType.Diagnostic);",
                    "            }",
                    "        }",
                    "",
                    "        /// <summary>Checks if today's date is one of the specified fertiliser application dates.</summary>",
                    "        private bool OnApplicationDate()",
                    "        {",
                    "            if (EachYear)",
                    "                return Dates.Any(d => DateUtilities.DatesEqual(d, clock.Today));",
                    "            ",
                    "            DateTime[] dates = Dates.Select(d => DateTime.ParseExact(d, \"d-MMM-yyyy\", null)).ToArray();",
                    "            return dates.Any(d => SameDate(d, clock.Today));",
                    "        }",
                    "",
                    "        /// <summary>Checks if N content in soil is below critical threshold.</summary>",
                    "        private bool NContentBelowThreshold()",
                    "        {",
                    "            if (!UseCritNThreshold)",
                    "                return true;",
                    "            ",
                    "            double[] weights = GetLayerWeights();",
                    "            double cumSoilN = 0;",
                    "",
                    "            for (int i = 0; i < soilPhysical.Thickness.Length; i++)",
                    "            {",
                    "                cumSoilN += weights[i] * nutrient.MineralN[i];",
                    "            }",
                    "",
                    "            return cumSoilN <= CritNThreshold;",
                    "        }",
                    "",
                    "        private double[] GetLayerWeights()",
                    "        {",
                    "            double[] weights = new double[soilPhysical.Thickness.Length];",
                    "            double cumDepth = 0;",
                    "",
                    "            for (int i = 0; i < soilPhysical.Thickness.Length; i++)",
                    "            {",
                    "                cumDepth += soilPhysical.Thickness[i];",
                    "                if (cumDepth < CritNDepth)",
                    "                    weights[i] = 1;",
                    "                else if (cumDepth - soilPhysical.Thickness[i] <= CritNDepth)",
                    "                    weights[i] = (CritNDepth - (cumDepth - soilPhysical.Thickness[i])) / soilPhysical.Thickness[i];",
                    "                else",
                    "                    weights[i] = 0;",
                    "            }",
                    "",
                    "            return weights;",
                    "        }",
                    "",
                    "        private bool SameDate(DateTime d1, DateTime d2)",
                    "        {",
                    "            return d1.Year == d2.Year && d1.DayOfYear == d2.DayOfYear;",
                    "        }",
                    "    }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "EachYear",
                      "Value": "True"
                    },
                    {
                      "Key": "Dates",
                      "Value": "30-nov, 15-apr"
                    },
                    {
                      "Key": "UseCritNThreshold",
                      "Value": "False"
                    },
                    {
                      "Key": "CritNThreshold",
                      "Value": "50"
                    },
                    {
                      "Key": "CritNDepth",
                      "Value": "75"
                    },
                    {
                      "Key": "Depth",
                      "Value": "50"
                    },
                    {
                      "Key": "Amount",
                      "Value": "25"
                    },
                    {
                      "Key": "FertiliserType",
                      "Value": "UreaN"
                    }
                  ],
                  "Name": "AutomaticFertiliser",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using APSIM.Core;",
                    "using Models.Interfaces;",
                    "using Models.PMF.Organs;",
                    "using APSIM.Shared.Utilities;",
                    "using System.Xml.Serialization;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using Models.Core;",
                    "using System;",
                    "using System.Linq;",
                    "using Models.Soils.Nutrients;",
                    "using Models.PMF.Phen;",
                    "using Newtonsoft.Json;",
                    "",
                    "        ",
                    "namespace Models",
                    "{",
                    "    [Serializable] ",
                    "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                    "    public class Script : Model, IStructureDependency",
                    "    {      ",
                    "        [Link] private Zone myZone;",
                    "        [Link] private Clock Clock;",
                    "        [Link] private ISummary summary;",
                    "        [Link] private IPhysical soilPhysical;",
                    "        [Link] private ISoilWater waterBalance;",
                    "        private int indexBottomOfMonitoredLayer;",
                    "        private double fractionBottomOfMonitoredLayer;",
                    "        private double lowerLimitOfMonitoredLayer;",
                    "        private double upperLimitOfMonitoredLayer;",
                    "        private double depthOfMonitoredLayer;",
                    "        public IStructure Structure { private get; set; }",
                    "",
                    "        //User inputs from properties tab",
                    "        [Description(\"Depth to monitor soil moisture is based on root depth?\")]",
                    "        public bool DepthToMonitorFollowRoots { get; set; }",
                    "        [Description(\"Minimum depth to monitor soil moisture (mm):\")]",
                    "        [Display(VisibleCallback = \"usingRootDepth\")]",
                    "        public double MinimumDepth { get; set; }",
                    "        [Description(\"Depth to monitor soil moisture (mm):\")]",
                    "        [Display(VisibleCallback = \"usingGivenDepth\")]",
                    "        public double DepthToMonitor { get; set; }",
                    "",
                    "        //Class members",
                    "        [JsonIgnore][Units(\"mm\")] public double SoilWaterContentOfMonitoredLayer { get; set; }",
                    "        [JsonIgnore][Units(\"mm\")] public double SoilAvailableWaterOfMonitoredLayer { get; set; }",
                    "        [JsonIgnore][Units(\"mm\")] public double RelativeSoilMoistureOfMonitoredLayer { get; set; }",
                    "        [JsonIgnore][Units(\"mm\")] public double SoilWaterDeficitOfMonitoredLayer { get; set; }",
                    "        //[JsonIgnore][Units(\"dry/moist/wet\")] public string SoilStatusOfMonitoredLayer { get; set; }",
                    "        [JsonIgnore][Units(\"0 or 1\")] public double SoilStatusOfMonitoredLayer { get; set; }",
                    "",
                    "",
                    "        ",
                    "        private bool usingRootDepth  { get { return DepthToMonitorFollowRoots; } }",
                    "        private bool usingGivenDepth { get { return !DepthToMonitorFollowRoots; } }",
                    "",
                    "",
                    "",
                    "        ",
                    "",
                    "        [EventSubscribe(\"StartOfSimulation\")]",
                    "        private void OnStartOfSimulation(object sender, EventArgs e)",
                    "        {",
                    "            // check the depth to monitor",
                    "            depthOfMonitoredLayer = DepthToMonitor;",
                    "            if (DepthToMonitorFollowRoots)",
                    "            {",
                    "                depthOfMonitoredLayer = MinimumDepth;",
                    "            }",
                    "",
                    "            // get some soil water variables",
                    "            getMonitoredLayerParams(depthOfMonitoredLayer);",
                    "       }",
                    "",
                    "       //[EventSubscribe(\"StartOfDay\")]",
                    "        [EventSubscribe(\"EndOfDay\")]",
                    "        private void OnStartOfDay(object sender, EventArgs e)",
                    "        {",
                    "            // check whether depth to monitor varies",
                    "            if (DepthToMonitorFollowRoots)",
                    "            {",
                    "                // check root depth",
                    "                double currentRootDepth = 0.0;",
                    "                foreach (Plant species in myZone.FindAllChildren<Plant>().OfType<IModel>().ToList())",
                    "                {",
                    "                    if (species.IsAlive)",
                    "                    {",
                    "                        double thisRootDepth = (double)Structure.Get(\"[\" + species.Name + \"].Root.Depth\", relativeTo: myZone);",
                    "                        currentRootDepth = Math.Max(currentRootDepth, thisRootDepth);",
                    "                    }",
                    "                }",
                    "                currentRootDepth = Math.Min(MinimumDepth, currentRootDepth);",
                    "                ",
                    "                if (Math.Abs(currentRootDepth - depthOfMonitoredLayer) > 0.001)",
                    "                { // update some soil water variables",
                    "                    depthOfMonitoredLayer = currentRootDepth;",
                    "                    getMonitoredLayerParams(depthOfMonitoredLayer);",
                    "                }",
                    "            }",
                    "",
                    "            // get current soil moisture",
                    "            SoilWaterContentOfMonitoredLayer = 0.0;",
                    "            for (int layer = 0; layer < indexBottomOfMonitoredLayer; layer++)",
                    "            {",
                    "                SoilWaterContentOfMonitoredLayer += waterBalance.SWmm[layer];",
                    "            }",
                    "",
                    "            SoilWaterContentOfMonitoredLayer += waterBalance.SWmm[indexBottomOfMonitoredLayer] * fractionBottomOfMonitoredLayer;",
                    "",
                    "            // compute soil water deficit and available water",
                    "            SoilWaterDeficitOfMonitoredLayer = SoilWaterContentOfMonitoredLayer - upperLimitOfMonitoredLayer;",
                    "            SoilAvailableWaterOfMonitoredLayer = SoilWaterContentOfMonitoredLayer - lowerLimitOfMonitoredLayer;",
                    "            RelativeSoilMoistureOfMonitoredLayer = SoilAvailableWaterOfMonitoredLayer/(upperLimitOfMonitoredLayer - lowerLimitOfMonitoredLayer);",
                    "",
                    "            // check the water status",
                    "            if (RelativeSoilMoistureOfMonitoredLayer >= 1.0)",
                    "            {",
                    "                //SoilStatusOfMonitoredLayer = \"wet\";",
                    "                SoilStatusOfMonitoredLayer = 1.0;",
                    "            }",
                    "            else if (RelativeSoilMoistureOfMonitoredLayer >= 0.5)",
                    "            {",
                    "                //SoilStatusOfMonitoredLayer = \"moist\";",
                    "                SoilStatusOfMonitoredLayer = 0.0;",
                    "            }",
                    "            else",
                    "            {",
                    "                //SoilStatusOfMonitoredLayer = \"dry\";",
                    "                SoilStatusOfMonitoredLayer = 0.0;",
                    "            }",
                    "        }",
                    "              ",
                    "        ",
                    "        ///<summary>Computes a selection of soil params over the given depth.</summary>",
                    "        private void getMonitoredLayerParams(double depthToCompute)",
                    "        {",
                    "            // Calculate some soil water variables",
                    "            double depthFromSurface = 0.0;",
                    "            lowerLimitOfMonitoredLayer = 0.0;",
                    "            upperLimitOfMonitoredLayer = 0.0;",
                    "            for (int layer = 0; layer < soilPhysical.Thickness.Length; layer++)",
                    "            {",
                    "                fractionBottomOfMonitoredLayer = Math.Min(1.0, (depthToCompute - depthFromSurface) / soilPhysical.Thickness[layer]);",
                    "                lowerLimitOfMonitoredLayer += soilPhysical.LL15mm[layer] * fractionBottomOfMonitoredLayer;",
                    "                upperLimitOfMonitoredLayer += soilPhysical.DULmm[layer] * fractionBottomOfMonitoredLayer;",
                    "                depthFromSurface += soilPhysical.Thickness[layer];",
                    "                if (depthFromSurface >= depthToCompute)",
                    "                {",
                    "                    indexBottomOfMonitoredLayer = layer;",
                    "                    layer = soilPhysical.Thickness.Length;",
                    "                }",
                    "            }",
                    "        }",
                    "       ",
                    "    }",
                    "}",
                    "             ",
                    "             "
                  ],
                  "Parameters": [
                    {
                      "Key": "DepthToMonitorFollowRoots",
                      "Value": "False"
                    },
                    {
                      "Key": "MinimumDepth",
                      "Value": "0"
                    },
                    {
                      "Key": "DepthToMonitor",
                      "Value": "600"
                    }
                  ],
                  "Name": "WaterStatus",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils;",
                    "using System;",
                    "using Models.Core;",
                    "using System.Collections.Generic;",
                    "using System.Text;",
                    "using Models.PMF;",
