                  "Key": "InitialRootDepth",
                  "Value": "5"
                },
                {
                  "Key": "CropToSow",
                  "Value": "Heyward_KK"
                },
                {
                  "Key": "SowingDate",
                  "Value": "05/25/2014 00:00:00"
                }
