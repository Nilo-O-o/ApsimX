                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Newtonsoft.Json;",
                    "using APSIM.Shared.Utilities;",
                    "using System.Xml.Serialization;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using Models.Core;",
                    "using System;",
                    "using System.Linq;",
                    "using Models.Interfaces;",
                    "",
                    "",
                    "",
                    "        ",
                    "namespace Models",
                    "{",
                    "    [Serializable] ",
                    "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] private ISummary summary;",
                    "        [Link] private Irrigation Irrigation;",
                    "        [Link] private Clock Clock;",
                    "        [Link] private Soil Soil;",
                    "        [Link(IsOptional = true)] private IPlant existingCrop;",
                    "        private DateTime StartDate;",
                    "        private DateTime EndDate;",
                    "        private double TopDUL;",
                    "        private double TopLL;",
                    "        private int nLayers;",
                    "        [Link]",
                    "        private IPhysical soilPhysical;",
                    "        [Link]",
                    "        private ISoilWater waterBalance;",
                    "        //Communication to other modules",
                    "       ",
                    "        //User inputs from properties tab",
                    "        [Description(\"Turn irrigation on?\")]",
                    "        public bool allowIrrigation { get; set; }",
                    "        [Description(\"Start of irrigation season (dd-MMM)\")]",
                    "        public string seasonStart { get; set; }",
                    "        [Description(\"End of irrigation season (dd-MMM)\")]",
                    "        public string seasonEnd { get; set; }",
                    "        [Description(\"Season allocation (mm)\")]",
                    "        public double seasonsAllocation { get; set; }",
                    "        [Description(\"Deficit to trigger irrigation (% PAWC)\")]",
                    "        public double triggerDeficit { get; set; }",
                    "        [Description(\"Deficit to stop irrigaton (% PAWC)\")]",
                    "        public double targetDeficit { get; set; }",
                    "        [Description(\"Minimum days for irrigation to return\")]",
                    "        public double returndays { get; set; }",
                    "        [Description(\"Maximum irrigation application (mm/day)\")]",
                    "        public double maximumAmount { get; set; }",
                    "        [Description(\"Depth to calculate PAWC (mm)\")]",
                    "        public double depthPAWC { get; set; }",
                    "",
                    "        //Class members",
                    "        [JsonIgnore] public double TopSWdeficit { get; set; }",
                    "        [JsonIgnore] public double TopSWC { get; set; }",
                    "        [JsonIgnore] public double DaysSinceIrrigation { get; set; }",
                    "        [JsonIgnore] public double AmountToApply { get; set; }",
                    "        [JsonIgnore] public double SeasonAppliedAmount { get; set; }",
                    "        ",
                    "        private bool IrrigationIsAllowed { get; set; }",
                    "        private bool SeasonIsOpen { get; set; }",
                    "        private bool CropIsActive { get; set; }",
                    "        private bool IrrigatorIsAvailable { get; set; }",
                    "        private bool SoilIsDry { get; set; }",
                    "",
                    "    ",
                    "        //Calculate static soil variables",
                    "        [EventSubscribe(\"StartOfSimulation\")]",
                    "        private void OnStartOfSimulation(object sender, EventArgs e)",
                    "        {   ",
                    "            //Set the season dates",
                    "            StartDate = DateTime.Parse(seasonStart + \"-\" + Clock.Today.Year.ToString());",
                    "            EndDate = DateTime.Parse(seasonEnd + \"-\" + Clock.Today.Year.ToString());",
                    "            ",
                    "            //Can we irrigate at all?",
                    "            IrrigationIsAllowed = false; ",
                    "            if (allowIrrigation)",
                    "                IrrigationIsAllowed = true; ",
                    "",
                    "            //Calculate soil water variables",
                    "            double depthFromSurface = 0.0;",
                    "            double fracLayer = 0.0;",
                    "            nLayers = soilPhysical.Thickness.Length;",
                    "            for (int layer = 0; layer < nLayers; layer++)",
                    "            {",
                    "                fracLayer = Math.Min(1.0, (depthPAWC - depthFromSurface) / soilPhysical.Thickness[layer]);",
                    "                TopLL += soilPhysical.LL15mm[layer] * fracLayer;",
                    "                TopDUL += soilPhysical.DULmm[layer] * fracLayer;",
                    "                depthFromSurface += soilPhysical.Thickness[layer];",
                    "                if (depthFromSurface >= depthPAWC)",
                    "                    layer = nLayers;",
                    "            }",
                    "        }",
                    "             ",
                    "        //Determine daily requirement for irrigation",
                    "        [EventSubscribe(\"StartOfDay\")]",
                    "        private void OnStartOfDay(object sender, EventArgs e)",
                    "        {",
                    "            //Can we irrigate today?          ",
                    "            SeasonIsOpen = isBetween(Clock.Today, StartDate, EndDate);",
                    "            if (!SeasonIsOpen)",
                    "                SeasonAppliedAmount = 0;",
                    "",
                    "            //Is there a crop in the ground that needs irrigation?",
                    "            CropIsActive = false;",
                    "            if ((existingCrop != null) && (existingCrop.IsAlive))",
                    "                CropIsActive = true;",
                    "            //if ((existingCrop.Phenology.Stage >= 3.0) && (existingCrop.Phenology.Stage < 6.0))",
                    "          ",
                    "            //Is the irrigator available?",
                    "            IrrigatorIsAvailable = false;",
                    "            DaysSinceIrrigation += 1;",
                    "            if (DaysSinceIrrigation >= returndays)",
                    "                IrrigatorIsAvailable = true;",
                    "          ",
                    "            //Is the soil dry enough to require irrigation?",
                    "            SoilIsDry = false;",
                    "            double depthFromSurface = 0.0;",
                    "            double fracLayer = 0.0;",
                    "            TopSWC = 0.0;",
                    "            for (int layer = 0; layer < nLayers; layer++)",
                    "            //for (int layer = 0; depthFromSurface < depthPAWC + soilPhysical.Thickness[layer]; layer++)",
                    "            {",
                    "                fracLayer = Math.Min(1.0, (depthPAWC - depthFromSurface) / soilPhysical.Thickness[layer]);",
                    "                TopSWC += waterBalance.SWmm[layer] * fracLayer;",
                    "                depthFromSurface += soilPhysical.Thickness[layer];",
                    "                if (depthFromSurface >= depthPAWC)",
                    "                    layer = nLayers;",
                    "            }",
                    "            ",
                    "            TopSWdeficit = TopSWC - TopDUL;",
                    "            if (Math.Max(0.0, -TopSWdeficit) >= (TopDUL - TopLL) * (100 - triggerDeficit) / 100)",
                    "                SoilIsDry = true;",
                    "                ",
                    "            //Are all the conditions ratifying irrigation",
                    "            if (IrrigationIsAllowed && SeasonIsOpen && CropIsActive && IrrigatorIsAvailable && SoilIsDry)",
                    "            {",
                    "                //Lets bloody well irrigate then!!!!",
                    "                AmountToApply = TopDUL * targetDeficit / 100 - TopSWC;",
                    "                AmountToApply = Math.Max(0.0, Math.Min(AmountToApply, seasonsAllocation - SeasonAppliedAmount));",
                    "                AmountToApply = Math.Min(AmountToApply,maximumAmount);",
                    "                Irrigation.Apply(AmountToApply);",
                    "                DaysSinceIrrigation = 0;",
                    "                SeasonAppliedAmount += AmountToApply;",
                    "            }",
                    "        }",
                    "        ",
                    "        ///Checks whether theDate is between iniDate and endDate (non-year specific)",
                    "        private bool isBetween(DateTime theDay, DateTime iniDate, DateTime endDate)",
                    "        {",
                    "            bool result = false;",
                    "            if (iniDate.DayOfYear < endDate.DayOfYear)",
                    "            {",
                    "                // period is within one year, ex: summer in the northern hemisphere",
                    "                if ((theDay.DayOfYear >= iniDate.DayOfYear) && (theDay.DayOfYear <= endDate.DayOfYear))",
                    "                    result = true;",
                    "            }",
                    "            else",
                    "            {",
                    "                // period goes over the end of the year, ex: summer in the southern hemisphere",
                    "                if ((theDay.DayOfYear >= iniDate.DayOfYear) || (theDay.DayOfYear <= endDate.DayOfYear))",
                    "                    result = true;",
                    "            }",
                    "            ",
                    "            return result;",
                    "        }",
                    "    }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "allowIrrigation",
                      "Value": "True"
                    },
                    {
                      "Key": "seasonStart",
                      "Value": "1-Aug"
                    },
                    {
                      "Key": "seasonEnd",
                      "Value": "30-May"
                    },
                    {
                      "Key": "seasonsAllocation",
                      "Value": "1000"
                    },
                    {
                      "Key": "triggerDeficit",
                      "Value": "70"
                    },
                    {
                      "Key": "targetDeficit",
                      "Value": "95"
                    },
                    {
                      "Key": "returndays",
                      "Value": "3"
                    },
                    {
                      "Key": "maximumAmount",
                      "Value": "30"
                    },
                    {
                      "Key": "depthPAWC",
                      "Value": "650"
                    }
                  ],
                  "Name": "AutomaticIrrigation",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils;",
                    "using Models.Core;",
                    "using System;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        //> Links to other Apsim models",
                    "        [Link] Clock Clock;",
                    "        [Link] ISummary mySummary;",
                    "",
                    "        //> User inputs from properties tab",
                    "        [Separator(\"Tags used to defined simulation factors\")]",
                    "        [Description(\"Agent number: \")]",
                    "        public string AGENT_NO { get; set; }",
                    "        [Description(\"Latitude: \")]",
                    "        public string Lat { get; set; }",
                    "        [Description(\"Longitude: \")]",
                    "        public string Lon { get; set; }",
                    "        [Description(\"SoilStamp: \")]",
                    "        public string SoilStamp { get; set; }",
                    "        [Description(\"GCM: \")]",
                    "        public string GCM { get; set; }",
                    "        [Description(\"RCP: \")]",
                    "        public string RCP { get; set; }",
                    "        [Description(\"Time slice: \")]",
                    "        public string TS { get; set; }",
                    "",
                    "        //> Internal variables",
                    "        private string someVar;",
                    "        ",
                    "        [EventSubscribe(\"DoManagementCalculations\")]",
                    "        private void OnDoManagementCalculations(object sender, EventArgs e)",
                    "        {",
                    "            // Sort out time slice classification",
                    "            if ((Clock.Today.Date.Year <= 2005))",
                    "            {",
                    "                TS = \"Baseline\";",
                    "            }",
                    "            else",
                    "            {",
                    "                TS = \"Future\";",
                    "            }",
                    "        }",
                    "    }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "AGENT_NO",
                      "Value": "999"
                    },
                    {
                      "Key": "Lat",
                      "Value": "999"
                    },
                    {
                      "Key": "Lon",
                      "Value": "999"
                    },
                    {
                      "Key": "SoilStamp",
                      "Value": "SiltLoam"
                    },
                    {
                      "Key": "GCM",
                      "Value": "ERA"
                    },
                    {
                      "Key": "RCP",
                      "Value": "ERA"
                    },
                    {
                      "Key": "TS",
                      "Value": "BaseLine"
                    }
                  ],
                  "Name": "FactorLabels",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using APSIM.Core;",
                    "using Models.Soils.Nutrients;",
                    "using System;",
                    "using Models.Core;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using APSIM.Shared.Utilities;",
                    "using System.Linq;",
                    "using Models.Interfaces;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model, IStructureDependency",
                    "    {",
                    "        [Link] private Clock clock;",
                    "        [Link] private Fertiliser fertiliser;",
                    "        [Link] private ISummary summary;",
                    "        [Link] private Soil soil;",
                    "        private Nutrient nutrient;",
                    "        [Link]",
                    "        private IPhysical soilPhysical;",
                    "        public IStructure Structure { private get; set; }",
                    "        ",
                    "        ",
                    "",
                    "",
                    "        [Separator(\"Fertiliser will be applied on the date(s) below\")]",
                    "        [Description(\"Apply fertiliser on the same day(s) each year? If no, then must include the year of appliaction below\")]",
                    "        public bool EachYear { get; set; }",
                    "",
                    "        [Description(\"Dates for one or more fertiliser applications (dd-mmm or dd-mmm-yyyy) as a list with a comma between dates\")]",
                    "        public string[] Dates { get; set; }",
                    "",
                    "        [Separator(\"Test for the mineral N in the soil and don't apply the fertiliser if greater than X kgN/ha is stored in the soil above a depth of Y mm\")]",
                    "        [Description(\"Use a critical soil mineral N to prevent application above a threshold?\")]",
                    "        public bool UseCritNThreshold { get; set; }",
                    "",
                    "        [Description(\"Don't add fertiliser if N in the soil to the depth below exceeds (kg/ha)\")]",
                    "        public double CritNThreshold { get; set; }",
                    "",
                    "        [Description(\"Depth to which the amount of N in the soil should be calculated (mm)\")]",
                    "        public double CritNDepth { get; set; }",
                    "",
                    "        [Separator(\"Fertiliser application details\")]",
                    "        [Description(\"Depth at which to apply the fertiliser (mm)\")]",
                    "        public double Depth { get; set; }",
                    "",
                    "        [Description(\"Amount of fertiliser to apply (kg N /ha) per application\")]",
                    "        public double Amount { get; set; }",
                    "",
                    "        [Description(\"Fertiliser type - select from the list\")]",
                    "        [Display(Type = DisplayType.FertiliserType)]public string FertiliserType { get; set; }",
                    "",
                    "",
                    "        [EventSubscribe(\"StartOfSimulation\")]",
                    "        private void FindSoilNOrNutrient(object sender, EventArgs e)",
                    "        {",
                    "            nutrient =  Structure.Find<Nutrient>() as Nutrient;",
                    "",
                    "            if (nutrient == null)",
                    "                throw new Exception(string.Format(\"Error in script {0}: Unable to find nutrient.\", Name));",
                    "        }",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            if (OnApplicationDate())",
                    "            {",
                    "                if (NContentBelowThreshold())",
                    "                    fertiliser.Apply(Amount, FertiliserType, Depth);",
                    "                else",
                    "                    summary.WriteMessage(this, \"Skipping fertiliser application due to soil mineral N content being above critical threshold.\", MessageType.Diagnostic);",
                    "            }",
                    "        }",
                    "",
                    "        /// <summary>Checks if today's date is one of the specified fertiliser application dates.</summary>",
                    "        private bool OnApplicationDate()",
                    "        {",
                    "            if (EachYear)",
                    "                return Dates.Any(d => DateUtilities.DatesEqual(d, clock.Today));",
                    "            ",
                    "            DateTime[] dates = Dates.Select(d => DateTime.ParseExact(d, \"d-MMM-yyyy\", null)).ToArray();",
                    "            return dates.Any(d => SameDate(d, clock.Today));",
                    "        }",
                    "",
                    "        /// <summary>Checks if N content in soil is below critical threshold.</summary>",
                    "        private bool NContentBelowThreshold()",
                    "        {",
                    "            if (!UseCritNThreshold)",
                    "                return true;",
                    "            ",
                    "            double[] weights = GetLayerWeights();",
                    "            double cumSoilN = 0;",
                    "",
                    "            for (int i = 0; i < soilPhysical.Thickness.Length; i++)",
                    "            {",
                    "                cumSoilN += weights[i] * nutrient.MineralN[i];",
                    "            }",
                    "",
                    "            return cumSoilN <= CritNThreshold;",
                    "        }",
                    "",
                    "        private double[] GetLayerWeights()",
                    "        {",
                    "            double[] weights = new double[soilPhysical.Thickness.Length];",
                    "            double cumDepth = 0;",
                    "",
                    "            for (int i = 0; i < soilPhysical.Thickness.Length; i++)",
                    "            {",
                    "                cumDepth += soilPhysical.Thickness[i];",
                    "                if (cumDepth < CritNDepth)",
                    "                    weights[i] = 1;",
                    "                else if (cumDepth - soilPhysical.Thickness[i] <= CritNDepth)",
                    "                    weights[i] = (CritNDepth - (cumDepth - soilPhysical.Thickness[i])) / soilPhysical.Thickness[i];",
                    "                else",
                    "                    weights[i] = 0;",
                    "            }",
                    "",
                    "            return weights;",
                    "        }",
                    "",
                    "        private bool SameDate(DateTime d1, DateTime d2)",
                    "        {",
                    "            return d1.Year == d2.Year && d1.DayOfYear == d2.DayOfYear;",
                    "        }",
                    "    }",
                    "}"
                  ],
                  "Parameters": [
                    {
                      "Key": "EachYear",
                      "Value": "True"
                    },
                    {
                      "Key": "Dates",
                      "Value": "30-nov, 15-apr"
                    },
                    {
                      "Key": "UseCritNThreshold",
                      "Value": "False"
                    },
                    {
                      "Key": "CritNThreshold",
                      "Value": "50"
                    },
                    {
                      "Key": "CritNDepth",
                      "Value": "75"
                    },
                    {
                      "Key": "Depth",
                      "Value": "50"
                    },
                    {
                      "Key": "Amount",
                      "Value": "25"
                    },
                    {
                      "Key": "FertiliserType",
                      "Value": "UreaN"
                    }
                  ],
                  "Name": "AutomaticFertiliser",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using APSIM.Core;",
                    "using Models.Interfaces;",
                    "using Models.PMF.Organs;",
                    "using APSIM.Shared.Utilities;",
                    "using System.Xml.Serialization;",
                    "using Models.Soils;",
                    "using Models.PMF;",
                    "using Models.Core;",
                    "using System;",
                    "using System.Linq;",
                    "using Models.Soils.Nutrients;",
                    "using Models.PMF.Phen;",
                    "using Newtonsoft.Json;",
                    "",
                    "        ",
                    "namespace Models",
                    "{",
                    "    [Serializable] ",
                    "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                    "    public class Script : Model, IStructureDependency",
                    "    {      ",
                    "        [Link] private Zone myZone;",
                    "        [Link] private Clock Clock;",
                    "        [Link] private ISummary summary;",
                    "        [Link] private IPhysical soilPhysical;",
                    "        [Link] private ISoilWater waterBalance;",
                    "        private int indexBottomOfMonitoredLayer;",
                    "        private double fractionBottomOfMonitoredLayer;",
                    "        private double lowerLimitOfMonitoredLayer;",
                    "        private double upperLimitOfMonitoredLayer;",
                    "        private double depthOfMonitoredLayer;",
                    "        ",
                    "        public IStructure Structure { private get; set; }",
                    "",
                    "",
                    "        //User inputs from properties tab",
                    "        [Description(\"Depth to monitor soil moisture is based on root depth?\")]",
                    "        public bool DepthToMonitorFollowRoots { get; set; }",
                    "        [Description(\"Minimum depth to monitor soil moisture (mm):\")]",
                    "        [Display(VisibleCallback = \"usingRootDepth\")]",
                    "        public double MinimumDepth { get; set; }",
                    "        [Description(\"Depth to monitor soil moisture (mm):\")]",
                    "        [Display(VisibleCallback = \"usingGivenDepth\")]",
                    "        public double DepthToMonitor { get; set; }",
                    "",
                    "        //Class members",
                    "        [JsonIgnore][Units(\"mm\")] public double SoilWaterContentOfMonitoredLayer { get; set; }",
                    "        [JsonIgnore][Units(\"mm\")] public double SoilAvailableWaterOfMonitoredLayer { get; set; }",
                    "        [JsonIgnore][Units(\"mm\")] public double RelativeSoilMoistureOfMonitoredLayer { get; set; }",
                    "        [JsonIgnore][Units(\"mm\")] public double SoilWaterDeficitOfMonitoredLayer { get; set; }",
                    "        //[JsonIgnore][Units(\"dry/moist/wet\")] public string SoilStatusOfMonitoredLayer { get; set; }",
                    "        [JsonIgnore][Units(\"0 or 1\")] public double SoilStatusOfMonitoredLayer { get; set; }",
                    "",
                    "",
                    "        ",
                    "        private bool usingRootDepth  { get { return DepthToMonitorFollowRoots; } }",
                    "        private bool usingGivenDepth { get { return !DepthToMonitorFollowRoots; } }",
                    "",
                    "",
                    "",
                    "        ",
                    "",
                    "        [EventSubscribe(\"StartOfSimulation\")]",
                    "        private void OnStartOfSimulation(object sender, EventArgs e)",
                    "        {",
                    "            // check the depth to monitor",
                    "            depthOfMonitoredLayer = DepthToMonitor;",
                    "            if (DepthToMonitorFollowRoots)",
                    "            {",
                    "                depthOfMonitoredLayer = MinimumDepth;",
                    "            }",
                    "",
                    "            // get some soil water variables",
                    "            getMonitoredLayerParams(depthOfMonitoredLayer);",
                    "       }",
                    "",
                    "       //[EventSubscribe(\"StartOfDay\")]",
                    "        [EventSubscribe(\"EndOfDay\")]",
                    "        private void OnStartOfDay(object sender, EventArgs e)",
                    "        {",
                    "            // check whether depth to monitor varies",
                    "            if (DepthToMonitorFollowRoots)",
                    "            {",
                    "                // check root depth",
                    "                double currentRootDepth = 0.0;",
                    "                foreach (Plant species in   Structure.FindChildren<Plant>(recurse: true, relativeTo: (INodeModel)myZone).OfType<IModel>().ToList())",
                    "                {",
                    "                    if (species.IsAlive)",
                    "                    {",
                    "                        double thisRootDepth = (double)Structure.Get(\"[\" + species.Name + \"].Root.Depth\", relativeTo: myZone);",
                    "                        currentRootDepth = Math.Max(currentRootDepth, thisRootDepth);",
                    "                    }",
                    "                }",
                    "                currentRootDepth = Math.Min(MinimumDepth, currentRootDepth);",
                    "                ",
                    "                if (Math.Abs(currentRootDepth - depthOfMonitoredLayer) > 0.001)",
                    "                { // update some soil water variables",
                    "                    depthOfMonitoredLayer = currentRootDepth;",
                    "                    getMonitoredLayerParams(depthOfMonitoredLayer);",
                    "                }",
                    "            }",
                    "",
                    "            // get current soil moisture",
                    "            SoilWaterContentOfMonitoredLayer = 0.0;",
                    "            for (int layer = 0; layer < indexBottomOfMonitoredLayer; layer++)",
                    "            {",
                    "                SoilWaterContentOfMonitoredLayer += waterBalance.SWmm[layer];",
                    "            }",
                    "",
                    "            SoilWaterContentOfMonitoredLayer += waterBalance.SWmm[indexBottomOfMonitoredLayer] * fractionBottomOfMonitoredLayer;",
                    "",
                    "            // compute soil water deficit and available water",
                    "            SoilWaterDeficitOfMonitoredLayer = SoilWaterContentOfMonitoredLayer - upperLimitOfMonitoredLayer;",
                    "            SoilAvailableWaterOfMonitoredLayer = SoilWaterContentOfMonitoredLayer - lowerLimitOfMonitoredLayer;",
                    "            RelativeSoilMoistureOfMonitoredLayer = SoilAvailableWaterOfMonitoredLayer/(upperLimitOfMonitoredLayer - lowerLimitOfMonitoredLayer);",
                    "",
                    "            // check the water status",
                    "            if (RelativeSoilMoistureOfMonitoredLayer >= 1.0)",
                    "            {",
                    "                //SoilStatusOfMonitoredLayer = \"wet\";",
                    "                SoilStatusOfMonitoredLayer = 1.0;",
                    "            }",
                    "            else if (RelativeSoilMoistureOfMonitoredLayer >= 0.5)",
                    "            {",
                    "                //SoilStatusOfMonitoredLayer = \"moist\";",
                    "                SoilStatusOfMonitoredLayer = 0.0;",
                    "            }",
                    "            else",
                    "            {",
                    "                //SoilStatusOfMonitoredLayer = \"dry\";",
                    "                SoilStatusOfMonitoredLayer = 0.0;",
                    "            }",
                    "        }",
                    "              ",
                    "        ",
                    "        ///<summary>Computes a selection of soil params over the given depth.</summary>",
                    "        private void getMonitoredLayerParams(double depthToCompute)",
                    "        {",
                    "            // Calculate some soil water variables",
                    "            double depthFromSurface = 0.0;",
                    "            lowerLimitOfMonitoredLayer = 0.0;",
                    "            upperLimitOfMonitoredLayer = 0.0;",
                    "            for (int layer = 0; layer < soilPhysical.Thickness.Length; layer++)",
                    "            {",
                    "                fractionBottomOfMonitoredLayer = Math.Min(1.0, (depthToCompute - depthFromSurface) / soilPhysical.Thickness[layer]);",
                    "                lowerLimitOfMonitoredLayer += soilPhysical.LL15mm[layer] * fractionBottomOfMonitoredLayer;",
                    "                upperLimitOfMonitoredLayer += soilPhysical.DULmm[layer] * fractionBottomOfMonitoredLayer;",
                    "                depthFromSurface += soilPhysical.Thickness[layer];",
                    "                if (depthFromSurface >= depthToCompute)",
                    "                {",
                    "                    indexBottomOfMonitoredLayer = layer;",
                    "                    layer = soilPhysical.Thickness.Length;",
                    "                }",
                    "            }",
                    "        }",
                    "       ",
                    "    }",
                    "}",
                    "             ",
                    "             "
                  ],
                  "Parameters": [
                    {
                      "Key": "DepthToMonitorFollowRoots",
                      "Value": "False"
                    },
                    {
                      "Key": "MinimumDepth",
                      "Value": "0"
                    },
                    {
                      "Key": "DepthToMonitor",
                      "Value": "600"
                    }
                  ],
                  "Name": "WaterStatus",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils.Nutrients;",
                    "using Models.Management;",
                    "using System;",
                    "using Models.Core;",
                    "using APSIM.Core;",
                    "using Models;",
                    "using Models.PMF;",
                    "using Models.Soils;",
                    "using Models.Soils.Nutrients;",
                    "using Models.Utilities;",
                    "using APSIM.Shared.Utilities;",
                    "using Models.PMF.Phen;",
                    "using Models.Functions.DemandFunctions;",
                    "using System.Diagnostics;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model, IStructureDependency",
                    "    {",
                    "        [Link] Plant KiwiFruit;",
                    "        [Link] Clock clock;",
                    "        [Link] Zone zone;",
                    "        [Link] AgriChemical agriChemical;",
                    "        [Link(Type = LinkType.Path, Path = \"[KiwiFruit].Phenology\")]",
                    "        private Phenology phenology;",
                    "        [Link(Type = LinkType.Path, Path = \"[KiwiFruit].Trunk.Girdle\")]",
                    "        private WoundFunction girdle;",
                    "        ",
                    "        public IStructure Structure {get; set;}",
                    "",
                    "        [Separator(\"Orchard configuration information\")]",
                    "        [Display(Type = DisplayType.CultivarName)]",
                    "        [Description(\"Cultivar to be sown\")]",
                    "        public string CultivarName { get; set; }",
                    "        ",
                    "        [Description(\"Age at the start of simulation\")]",
                    "        public int Age { get; set;} ",
                    "        ",
                    "        ////<summary>The vines are established on this date</summary>",
                    "        [Description(\"Date (d-mmm) of bud burst in first year\")]",
                    "        public string FirstBBDate { get; set;}         ",
                    "        ",
                    "        [Description(\"Sheltered.  Are wind breaks present?\")]",
                    "        public bool Sheltered { get; set;} ",
                    "        ",
                    "        [Description(\"Netted.  Is shade neddting present?\")]",
                    "        public bool Netted { get; set;} ",
                    "       ",
                    "        [Description(\"Choose training system\")]",
                    "        public TrainingSystemOptions TrainingSystem { get; set;} ",
                    "        ",
                    "        [Description(\"Row spacing (m)\")]",
                    "        public double RowSpacing { get; set;} ",
                    "        ",
                    "        [Description(\"Plant spacing (m)\")]",
                    "        public double PlantSpacing { get; set;} ",
                    "        ",
                    "        [Separator(\"HC Management info: If no dates specified default application occurs when chill units reach 1200.\")]",
                    "        ",
                    "        [Description(\"HC Used?\")]",
                    "        public bool HCUsed { get; set;}   ",
                    "        ",
                    "        [Description(\"HC Application Date (dd-MMM)\")]",
                    "        public string HCApplicationDate { get; set;}    ",
                    "        ",
                    "        [Description(\"HC rate\")]",
                    "        public double HCRate { get; set;}    ",
                    "        ",
                    "        [Separator(\"Girdling Management info: If no dates specified default date is 01-March\")]",
                    "        ",
                    "        [Description(\"Girdled?\")]",
                    "        public bool Girdled { get; set;} ",
                    "        ",
                    "        [Description(\"Girdling Date(s) (dd-MMM (comma separates))\")]",
                    "        public string GirdlingDates { get; set;}    ",
                    "        ",
                    "        public bool Applied { get; set;} ",
                    "        ",
                    "        public bool Established {get; set;} =  false;",
                    "        ",
                    "        public enum TrainingSystemOptions",
                    "        {",
                    "            /// <summary>Pergola training system.</summary>",
                    "            Pergola,",
                    "            /// <summary>T-Bar training system.</summary>",
                    "            Tbar",
                    "        }",
                    "        ",
                    "        [Separator(\"Set fruit number (fruit/m2): If no number is set, it is calculated as the estimated number of flowers.\")]",
                    "        ",
                    "        [Description(\"Bud Set Date (dd-MMM)\")]",
                    "        public string BudSetDate { get; set;} ",
                    "        [Description(\"Fruit Number\")]",
                    "        public double FruitNumber { get; set;} ",
                    "        ",
                    "        [EventSubscribe(\"StartOfDay\")]",
                    "        private void OnStartOfDay(object sender, EventArgs data)",
                    "        {",
                    "            if (!double.IsNaN(FruitNumber))",
                    "            {",
                    "                if (!String.IsNullOrEmpty(BudSetDate))",
                    "                {",
                    "                //Debugger.Break();",
                    "                if (DateUtilities.DatesEqual(BudSetDate,clock.Today))",
                    "                   Structure.Set(\"[KiwiFruit].Fruit.FruitNumberPerM2.FruitingPhase.FixedValue\", (object)FruitNumber);",
                    " ",
                    "                }",
                    "            }",
                    "        }",
                    "        ",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs data)",
                    "        {",
                    "            if (DateUtilities.DatesEqual(FirstBBDate,clock.Today) && (!Established))",
                    "            {",
                    "                Established = true;",
                    "                EstablishVines();",
                    "            }",
                    "            //Debugger.Break();",
                    "            if (HCUsed)",
                    "            {",
                    "                if (!String.IsNullOrEmpty(HCApplicationDate))",
                    "                    {",
                    "                    if (DateUtilities.DatesEqual(HCApplicationDate,clock.Today))",
                    "                       agriChemical.Apply();",
                    "                    }",
                    "                else ",
                    "                {",
                    "                IFunction chilling = (IFunction)Structure.Get(\"KiwiFruit.Phenology.AccumulatedChilling\", relativeTo:zone);",
                    "                if ((chilling.Value() >=1200) && (Applied == false))",
                    "                    {",
                    "                    agriChemical.Apply();",
                    "                    Applied = true; ",
                    "                    }",
                    "                }",
                    "                if (DateUtilities.DatesEqual(\"01-Jun\",clock.Today)) ",
                    "                    {",
                    "                    Applied = false; ",
                    "                    }",
                    "                    ",
                    "            }",
                    "            ",
                    "            if (Girdled)",
                    "            {",
                    "                string GirdlingDate = \"01-Mar\";",
                    "                if (!String.IsNullOrEmpty(GirdlingDates))",
                    "                    {",
                    "                    GirdlingDate = GirdlingDates;",
                    "                    }",
                    "                    if (DateUtilities.DatesEqual(GirdlingDate,clock.Today))",
                    "                       girdle.Event();",
                    "            }",
                    "        ",
                    "        }         ",
                    "        ",
                    "        [EventSubscribe(\"StartOfFirstDay\")]",
                    "        private void OnStartOfFirstDay(object sender, EventArgs data)",
                    "        {",
                    "            //EstablishVines();",
                    "        }     ",
                    "        ",
                    "        private void EstablishVines()",
                    "        {",
                    "            double Population = 1/(RowSpacing*PlantSpacing);",
                    "            KiwiFruit.Sow(cultivar: CultivarName, population: Population, depth: 3000, rowSpacing: RowSpacing*1000); ",
                    "            phenology.SetToStage(\"BudBreak\");",
                    "        }",
                    "        ",
                    "",
                    "}",
                    "}",
                    "    ",
                    ""
                  ],
                  "Parameters": [
                    {
                      "Key": "CultivarName",
                      "Value": "Heyward"
                    },
                    {
                      "Key": "Age",
                      "Value": "0"
                    },
                    {
                      "Key": "FirstBBDate",
                      "Value": "1-Aug"
                    },
                    {
                      "Key": "Sheltered",
                      "Value": "False"
                    },
                    {
                      "Key": "Netted",
                      "Value": "False"
                    },
                    {
                      "Key": "TrainingSystem",
                      "Value": "Pergola"
                    },
                    {
                      "Key": "RowSpacing",
                      "Value": "4"
                    },
                    {
                      "Key": "PlantSpacing",
                      "Value": "6"
                    },
                    {
                      "Key": "HCUsed",
                      "Value": "True"
                    },
                    {
                      "Key": "HCApplicationDate",
                      "Value": "03-Sep"
                    },
                    {
                      "Key": "HCRate",
                      "Value": "0"
                    },
                    {
                      "Key": "Girdled",
                      "Value": "False"
                    },
                    {
                      "Key": "GirdlingDates",
                      "Value": ""
                    },
                    {
                      "Key": "BudSetDate",
                      "Value": ""
                    },
                    {
                      "Key": "FruitNumber",
                      "Value": "NaN"
                    }
                  ],
                  "Name": "OrchardSetUp",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Management;",
                    "using System;",
                    "using Models.Core;",
                    "using APSIM.Core;",
                    "using Models;",
                    "using Models.PMF;",
                    "using Models.Utilities;",
                    "using APSIM.Shared.Utilities;",
                    "using Models.PMF.Phen;",
                    "using System.Diagnostics;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] Plant KiwiFruit;",
                    "        [Link] Clock clock;",
                    "        [Link(Type = LinkType.Path, Path = \"[KiwiFruit].Leaf.Canopy\")]",
                    "        private EnergyBalance canopy;",
                    "        [Link(Type = LinkType.Path, Path = \"[KiwiFruit].Phenology\")]",
                    "        private Phenology phenology;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)]",
                    "        private BiomassRemovalEvents SummerPrune;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)]",
                    "        private BiomassRemovalEvents Pick;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)]",
                    "        private BiomassRemovalEvents AutumnPrune;",
                    "        [Link(Type = LinkType.Scoped, ByName = true)]",
                    "        private BiomassRemovalEvents Defoliate;",
                    "        ",
                    "        [Separator(\"If left blank summer pruning does not happen\")]",
                    "        [Description(\"LAI threshold to trigger summer pruning\")]",
                    "        public double LAIthreshold { get; set; }",
                    "        ",
                    "        [Separator(\"If left blank picking occurs when the fruit reaches matruity\")]",
                    "        [Description(\"Picking date, dd-mmm\")]",
                    "        public string PickingDate { get; set; }",
                    "        ",
                    "        [Separator(\"If left blank autumn pruning occurs on the same day as picking\")]",
                    "        [Description(\"Autmun pruning date, dd-mmm\")]",
                    "        public string AutumnPruneDate { get; set; }",
                    "        ",
                    "        [Separator(\"If left blank winter pruning occurs at the end of the late leaf phase\")]",
                    "        [Description(\"Winter defoliation date, dd-mmm\")]",
                    "        public string WinterDefoliateDate { get; set; }",
                    "        ",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs data)",
                    "        {",
                    "        //Debugger.Break();",
                    "         // prune out leaf and stem every time the canopy gets to big",
                    "         if (double.IsNaN(LAIthreshold))",
                    "         {}",
                    "         else",
                    "         {",
                    "             if (canopy.LAI > LAIthreshold)",
                    "                 {",
                    "                     SummerPrune.Remove();",
                    "                 }",
                    "         }",
                    "         //Remove fruit on picking date if specified otherwise remove fruit when maturity is reached",
                    "         if (String.IsNullOrEmpty(PickingDate))",
                    "            {",
                    "             if (phenology.CurrentStageName == \"FruitMature\")",
                    "                    {",
                    "                        Pick.Remove();",
                    "                    } ",
                    "            }",
                    "         else",
                    "             {",
                    "                if (DateUtilities.DatesEqual(PickingDate,clock.Today)) ",
                    "                    {",
                    "                        Pick.Remove();",
                    "                    } ",
                    "             }",
                    "             ",
                    "         //Remove half of leaf and shoot biomass to approximate autumn pruning on date if specified otherwise do at fruit maturity    ",
                    "         if (String.IsNullOrEmpty(AutumnPruneDate))",
                    "            {",
                    "                if (phenology.CurrentStageName == \"FruitMature\")",
                    "                    {",
                    "                        AutumnPrune.Remove();",
                    "                    } ",
                    "            }",
                    "         else",
                    "            {",
                    "                if (DateUtilities.DatesEqual(AutumnPruneDate,clock.Today)) ",
                    "                    {",
                    "                        AutumnPrune.Remove();",
                    "                    }  ",
                    "            }",
                    "         ",
                    "         //Remove all leaf to approximate defoliation by spaying Copper Sulphate. ",
                    "         //Note, all stem is removed at this time too but it should be moved into a Cane organ as the remaining shoots is kept to provide buds for next year",
                    "         if (String.IsNullOrEmpty(WinterDefoliateDate))",
                    "            {",
                    "                 if (phenology.CurrentStageName == \"StartEndo\")",
                    "                    {",
                    "                        Defoliate.Remove();",
                    "                    }  ",
                    "            }",
                    "         else",
                    "            {",
                    "                if (DateUtilities.DatesEqual(WinterDefoliateDate,clock.Today)) ",
                    "                    {",
                    "                        Defoliate.Remove();",
                    "                    }  ",
                    "            }",
                    "   ",
                    "       }",
                    "    }",
                    "}",
                    "    ",
                    ""
                  ],
                  "Parameters": [
                    {
                      "Key": "LAIthreshold",
                      "Value": "3.9"
                    },
                    {
                      "Key": "PickingDate",
                      "Value": ""
                    },
                    {
                      "Key": "AutumnPruneDate",
                      "Value": ""
                    },
                    {
                      "Key": "WinterDefoliateDate",
                      "Value": ""
                    }
                  ],
                  "Name": "Pruning",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
