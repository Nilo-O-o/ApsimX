                      "TypeString": "Pruning",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 1.0,
                      "DeadToResidue": 1.0
                    },
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "Stem",
                      "TypeString": "Pruning",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 0.0,
                      "DeadToResidue": 0.0
                    },
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "Root",
                      "TypeString": "Pruning",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 0.0,
                      "DeadToResidue": 0.0
                    },
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "Fruit",
                      "TypeString": "Pruning",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 0.0,
                      "DeadToResidue": 0.0
                    }
                  ],
                  "Name": "OnPrune",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Management.BiomassRemovalEvents, Models",
                  "NameOfPlantToRemoveFrom": "KiwiFruit",
                  "RemovalType": 5,
                  "StageToSet": "",
                  "RemovalDates": null,
                  "BiomassRemovalFractions": [
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "Leaf",
                      "TypeString": "None",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 0.2,
                      "DeadToResidue": 0.2
                    },
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "Stem",
                      "TypeString": "None",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 0.2,
                      "DeadToResidue": 0.2
                    },
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "Trunk",
                      "TypeString": "None",
                      "LiveToRemove": 0.0,
                      "DeadToRemove": 0.0,
                      "LiveToResidue": 0.0,
                      "DeadToResidue": 0.0
                    },
                    {
                      "$type": "Models.Management.BiomassRemovalOfPlantOrganType, Models",
                      "PlantName": "KiwiFruit",
                      "OrganName": "StorageRoot",
                      "TypeString": "None",
                      "LiveToRemove": 0.0,
